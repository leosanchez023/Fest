<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/pages/entregas.css">











<div class="container">

  <!-- Page meta (injetado no header) -->
  <div class="page-meta" data-title="Controle de Entregas, Retiradas e Pagamentos" data-subtitle="Gerencie todo o ciclo de vida das locações em um só lugar"></div>

  <div style="display:flex; justify-content:flex-end; gap:8px; margin-bottom:18px;">
    <button class="btn"><i class="fa-solid fa-file-export icon-sm"></i> Exportar</button>
    <button class="btn-primary btn" onclick="carregarPedidos()"><i class="fa-solid fa-rotate icon-sm"></i> Atualizar</button>
  </div>

  <!-- KPIs -->
  <div class="grid grid-4" style="margin-bottom:20px;">
    <div class="kpi g-primary" onclick="filterByKpi('active')" style="cursor:pointer;">
  <h4>Pedidos Ativos</h4>
  <div class="val" id="kpi-active">0</div>
</div>

<div class="kpi g-info" onclick="filterByKpi('delivery')" style="cursor:pointer;">
  <h4>Entregas Hoje</h4>
  <div class="val" id="kpi-delivery">0</div>
</div>

<div class="kpi g-warning" onclick="filterByKpi('pickup')" style="cursor:pointer;">
  <h4>Retiradas Hoje</h4>
  <div class="val" id="kpi-pickup">0</div>
</div>

<div class="kpi g-danger" onclick="filterByKpi('late')" style="cursor:pointer;">
  <h4>Pagamentos Atrasados</h4>
  <div class="val" id="kpi-late">0</div>
</div>
  </div>

  </div>

  <!-- ALERTAS -->
  <div class="card" style="padding:20px; margin-bottom:20px;">
    <h2>🚨 Alertas</h2>
    <div class="grid grid-3" id="alerts"></div>
  </div>

  <!-- FILTROS -->
  <div class="card" style="padding:18px; margin-bottom:20px;">
    <h2>🔎 Filtros</h2>

    <div class="grid grid-6">

      <div>
        <label>Buscar</label>
        <input id="f-search" placeholder="Cliente, pedido..." />
      </div>

      <div>
        <label>Data inicial</label>
        <input type="date" id="f-from" />
      </div>

      <div>
        <label>Data final</label>
        <input type="date" id="f-to" />
      </div>

      <!-- PAGAMENTO -->
      <div>
        <label>Pagamento</label>
        <select id="f-pay">
          <option value="">Todos</option>
          <option value="Pago Integralmente">Pago Integralmente</option>
          <option value="Parcialmente Pago">Parcialmente Pago</option>
          <option value="Não Pago">Não Pago</option>
        </select>
      </div>

      <!-- ENTREGA -->
      <div>
        <label>Entrega <i class="fa-solid fa-triangle-exclamation icon-xs"></i></label>
        <select id="f-deliv">
          <option value="">Todas</option>
          <option value="Aguardando Entrega">Aguardando Entrega</option>
          <option value="Em Rota">Em Rota</option>
          <option value="Entregue">Entregue</option>
          <option value="Entrega Atrasada">Entrega Atrasada</option>
        </select>
      </div>

      <!-- STATUS (BANCO) -->
      <div>
        <label>Status</label>
        <select id="f-status">
          <option value="">Todos</option>
          <option value="ORCAMENTO">Orçamento</option>
          <option value="CONFIRMADO">Confirmado</option>
          <option value="EM_PREPARO">Em Preparo</option>
          <option value="ENTREGUE">Entregue</option>
          <option value="RETIRADO">Retirado</option>
          <option value="CONFERENCIA">Conferência</option>
          <option value="PENDENTE">Pendente</option>
          <option value="FINALIZADO">Finalizado</option>
          <option value="CANCELADO">Cancelado</option>
        </select>
      </div>

    </div>
  </div>

  <div class="card" style="padding:18px; margin-bottom:20px;">
    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <button class="btn" id="select-all">Selecionar todos</button>
      <button class="btn" id="deselect-all">Desmarcar todos</button>
      <button class="btn" id="invert-selection">Inverter seleção</button>
      <div style="margin-left:8px; font-weight:600;">Pedidos selecionados: <span id="selected-count">0</span></div>
      <div style="margin-left:auto; display:flex; gap:8px;">
        <button class="btn" id="toggle-order">Inverter ordem</button>
        <button class="btn-primary btn" id="generate-report">Gerar relatório de entrega</button>
      </div>
    </div>
  </div>

  <!-- TABELA -->
  <div class="card">
    <div style="padding:18px; display:flex; justify-content:space-between;">
      <h2><i class="fa-solid fa-clipboard icon-sm"></i> Pedidos</h2>
      <span id="count-badge">0 pedidos</span>
    </div>

    <div style="overflow-x:auto;">
      <table>
        <thead>
              <tr>
                <th style="width:40px"></th>
                <th>Pedido</th>
                <th>Cliente</th>
                <th>Evento <button id="toggle-event-order" class="btn-ghost" title="Alternar ordem por data do evento">↕</button></th>
                <th>Entrega</th>
                <th>Retirada</th>
                <th>Total</th>
                <th>Pago</th>
                <th>Status</th>
                <th></th>
              </tr>
        </thead>
        <tbody id="orders-tbody"></tbody>
      </table>
    </div>
  </div>

</div>

<!-- MODAL FINANCEIRO -->
<div class="finance-modal-overlay" id="finance-modal">
  <div class="finance-modal-card">
    <h3 id="finance-modal-title">Registrar pagamento</h3>
    <div style="display:flex; flex-direction:column; gap:10px;">
      <div>
        <label>Valor</label>
        <input id="finance-valor" type="number" min="0" step="0.01" placeholder="0,00" />
      </div>
      <div id="finance-method-group" style="display:none;">
        <label>Forma de pagamento</label>
        <select id="finance-forma-pagamento">
          <option value="">Selecione</option>
          <option value="PIX">PIX</option>
          <option value="Dinheiro">Dinheiro</option>
          <option value="Cartão">Cartão</option>
          <option value="Transferência">Transferência</option>
          <option value="Boleto">Boleto</option>
        </select>
      </div>
      <div>
        <label>Descrição / Observação</label>
        <textarea id="finance-descricao" rows="3" placeholder="Descreva o motivo"></textarea>
      </div>
    </div>
    <div class="actions">
      <button class="btn" id="finance-cancel-btn" type="button">Cancelar</button>
      <button class="btn-primary btn" id="finance-confirm-btn" type="button">Confirmar</button>
    </div>
  </div>
</div>

<div class="finance-modal-overlay" id="delivery-modal">
  <div class="finance-modal-card">
    <h3 id="delivery-modal-title">Confirmar entrega</h3>
    <div style="display:flex; flex-direction:column; gap:10px;">
      <div>
        <label>Data e hora da entrega</label>
        <input id="delivery-datetime" type="datetime-local" />
      </div>
      <div>
        <label>Responsável pela entrega</label>
        <input id="delivery-responsavel" placeholder="Nome do responsável" />
      </div>
      <div>
        <label>Observação</label>
        <textarea id="delivery-observacao" rows="3" placeholder="Informações adicionais da entrega"></textarea>
      </div>
    </div>
    <div class="actions">
      <button class="btn" id="delivery-cancel-btn" type="button">Cancelar</button>
      <button class="btn-primary btn" id="delivery-confirm-btn" type="button">Confirmar entrega</button>
    </div>
  </div>
</div>

<div class="finance-modal-overlay" id="return-modal">
  <div class="finance-modal-card" style="max-width:760px;">
    <h3 id="return-modal-title">Registrar devolução</h3>
    <div id="return-modal-body"></div>
    <div class="actions">
      <button class="btn" id="return-cancel-btn" type="button">Cancelar</button>
      <button class="btn-primary btn" id="return-confirm-btn" type="button">Confirmar devolução</button>
    </div>
  </div>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modal">
  <div class="modal">

      <div class="modal-header">
      <div>
        <div id="m-id">PED-0000</div>
        <div id="m-customer">Cliente</div>
        <div id="m-status" class="muted" style="margin-top:8px;"></div>
      </div>
      <button onclick="closeModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div class="modal-body">
      <div id="m-timeline"></div>

      <div class="tabs">
        <div class="tab active" data-tab="dados"><i class="fa-solid fa-file-lines icon-sm"></i> Dados</div>
        <div class="tab" data-tab="fin"><i class="fa-solid fa-dollar-sign icon-sm"></i> Financeiro</div>
        <div class="tab" data-tab="log"><i class="fa-solid fa-truck icon-sm"></i> Logística e Devolução</div>
        <div class="tab" data-tab="oco"><i class="fa-solid fa-triangle-exclamation icon-sm"></i> Ocorrências</div>
      </div>

      <div class="tab-panel active" id="tab-dados"><div id="m-dados"></div></div>
      <div class="tab-panel" id="tab-fin"><div id="m-fin"></div></div>
      <div class="tab-panel" id="tab-log"><div id="m-log"></div></div>
      <div class="tab-panel" id="tab-oco"><div id="m-oco"></div></div>

    </div>
  </div>
</div>

<script src="/js/entregas.js"></script>