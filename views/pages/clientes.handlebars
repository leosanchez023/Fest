<link rel="stylesheet" href="/css/pages/clientes.css">

<title>Cadastro de Clientes</title>


<!-- CABEÇALHO DA PÁGINA -->

<div class="page-meta" data-title="Clientes" data-subtitle="Gerencie seus clientes e informações de contato"></div>

<!-- BARRA DE FERRAMENTAS -->
<section class="client-toolbar">
    <form class="filter-form" onsubmit="submitFilter(event)">
        <input
            id="searchInput"
            name="q"
            type="search"
            placeholder="Pesquisar nome, email ou CPF"
            value="{{q}}">
        <select id="limitSelect" name="limit" aria-label="Clientes por página">
            <option value="10">10 por página</option>
            <option value="25">25 por página</option>
            <option value="50">50 por página</option>
        </select>
        <button class="btn btn-secondary" type="submit">Buscar</button>
    </form>
    <button type="button" class="btn btn-primary" onclick="openForm()">
        <i class="fa-solid fa-plus icon-sm"></i> Novo Cliente
    </button>
</section>

{{#if pageError}}
    <p class="client-page-error" role="alert">{{pageError}}</p>
{{/if}}
{{#if error_msg}}
    <p class="client-page-error" role="alert">{{error_msg}}</p>
{{/if}}
{{#if success_msg}}
    <p class="client-page-success" role="status">{{success_msg}}</p>
{{/if}}

<!-- FORMULÁRIO DE CADASTRO -->
<div id="formContainer" {{#if mostrarFormulario}}class="client-form-container is-open"{{else}}class="client-form-container"{{/if}}>
    {{> cadastro_cliente
        action="/clientes/criar"
        formAction=formAction
        formTitle=formTitle
        submitLabel=submitLabel
        formId="formulariocard"
        titulo=formTitle
        botaoSalvar=submitLabel
    }}
</div>

<main>
    <!-- TABELA DE CLIENTES -->
    <div class="table-wrap">
        <table class="client-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>CPF</th>
                    <th>Endereço</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                {{#if clientes.length}}
                    {{#each clientes}}

                            <!-- LINHA DO CLIENTE -->
                            <tr>
                                <td>{{this.cliente_id}}</td>
                                <td>{{this.nome}}</td>
                                <td>{{this.email}}</td>
                                <td>{{this.telefone}}</td>
                                <td>{{this.cpf}}</td>
                                <td>{{this.rua}} {{this.numero}} - {{this.cidade}}/{{this.estado}}</td>

                                <!-- AÇÕES -->
                                <td>
                                    <button
                                        type="button"
                                        class="btn btn-secondary btn-sm js-client-details"
                                        data-client-id="{{this.cliente_id}}">
                                        Detalhes
                                    </button>
                                    <a
                                        class="btn btn-secondary btn-sm"
                                        href="/clientes/editar/{{this.cliente_id}}">
                                        Editar
                                    </a>

                                    <!-- BOTÃO EXCLUIR -->
                                    <form
                                        class="inline-form js-delete-client"
                                        method="post"
                                        action="/clientes/excluir/{{this.cliente_id}}"
                                        data-client-name="{{this.nome}}">

                                        <button
                                            type="submit"
                                            class="btn btn-danger btn-sm">
                                            Excluir
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {{/each}}
                    {{else}}

                    <!-- CASO NÃO TENHA CLIENTES -->
                    <tr>
                        <td
                            colspan="7"
                            class="empty-row">
                            Nenhum cliente encontrado.
                        </td>
                    </tr>

                {{/if}}
            </tbody>
        </table>
    </div>

    <!-- PAGINAÇÃO -->
    <div class="pagination-row">
        <button
            class="btn"
            type="button"
            onclick="goToPage({{prevPage}})"
            {{#if isFirst}}disabled{{/if}}>
            Anterior
        </button>

        <span>Página {{page}} de {{totalPages}}</span>

        <button
            class="btn"
            type="button"
            onclick="goToPage({{nextPage}})"
            {{#if isLast}}disabled{{/if}}>
            Próxima
        </button>
    </div>
</main>

<dialog id="clientDetailsDialog" class="client-details-dialog" aria-labelledby="clientDetailsTitle">
    <div class="client-details-header">
        <h2 id="clientDetailsTitle">Detalhes do cliente</h2>
        <button type="button" class="btn btn-secondary btn-sm" data-close-details aria-label="Fechar detalhes">Fechar</button>
    </div>
    <p class="client-details-error" role="alert" hidden></p>
    <dl class="client-details-grid">
        <div><dt>Nome</dt><dd data-detail="nome"></dd></div>
        <div><dt>CPF</dt><dd data-detail="cpf"></dd></div>
        <div><dt>E-mail</dt><dd data-detail="email"></dd></div>
        <div><dt>Telefone</dt><dd data-detail="telefone"></dd></div>
        <div><dt>Nascimento</dt><dd data-detail="nascimento"></dd></div>
        <div><dt>Rua e número</dt><dd data-detail="rua_numero"></dd></div>
        <div><dt>Bairro</dt><dd data-detail="bairro"></dd></div>
        <div><dt>Cidade/Estado</dt><dd data-detail="cidade_estado"></dd></div>
        <div><dt>CEP</dt><dd data-detail="cep"></dd></div>
        <div><dt>Referência</dt><dd data-detail="referencia"></dd></div>
    </dl>
</dialog>

<!-- JAVASCRIPT DA PÁGINA -->
<script src="/js/clientes.js"></script>

<script>
    (function(){
        // Mantém o limite selecionado na paginação
        const limitSelect = document.getElementById('limitSelect');
        const currentLimit = '{{limit}}';

        if(limitSelect && currentLimit){ limitSelect.value = currentLimit;}
    })();
</script>