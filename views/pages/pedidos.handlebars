<link rel="stylesheet" href="/css/pages/pedidos.css">

<div class="container">

  <div class="page-meta" data-title="Pedidos" data-subtitle="Gerencie pedidos, clientes e pagamentos"></div>

  <!-- ================= DADOS DO PEDIDO ================= -->
  <div class="card">
    <div class="card-title">Dados do Pedido </div>

    <div class="field" style="margin-bottom:1rem">
      <label>Cliente</label>
      <div id="cliente-display"></div>
      <div id="cliente-painel" style="display:none; margin-top:10px;">

    <div class="client-panel">

        <div class="client-panel-header">
            <strong>Buscar ou cadastrar cliente</strong>

            <button type="button" class="btn-close" id="btn-fechar-painel"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="tabs">

            <button type="button" id="tab-buscar"><i class="fa-solid fa-magnifying-glass icon-sm"></i> Buscar</button>

            <button type="button" id="tab-cadastrar"><i class="fa-solid fa-plus icon-sm"></i> Cadastrar</button>

        </div>

        <div id="painel-body">
    <div id="buscar-cliente"></div>

    <div id="cadastro-cliente" style="display:none;">
    {{> cadastro_cliente
        action="/pedidos/criarCliente"
        formId="formClientePedido"
        titulo="Novo Cliente"
        botaoSalvar="Salvar Cliente"
    }}
</div>
</div>

    </div>

</div>
    </div>

    <div class="grid-3">

      <div class="field">
        <label>Telefone do Cliente</label>
        <input id="tel-cliente" class="input" type="tel">
      </div>

      <div class="field">
        <label>Telefone para Contato</label>
        <input id="tel-contato" class="input" type="tel">
        <div class="muted">Telefone alternativo (ex.: organizador, cerimonialista)</div>
      </div>

      <div class="field">
        <label>Data do Evento</label>
        <input id="data-evento" class="input" type="date">
      </div>

      <div class="field">
        <label>Data de Entrega</label>
        <input id="data-entrega" class="input" type="date">
      </div>

      <div class="field">
        <label>Data de Retirada</label>
        <input id="data-retirada" class="input" type="date">
      </div>

    </div>
  </div>

  <!-- ================= ITENS ================= -->
  <div class="card">
    <div class="card-title">Itens do Pedido</div>

    <div class="grid-3" style="align-items:end">

      <div class="field">
        <label>Produto ou combo</label>
        <div class="autocomplete-wrap">
          <input id="prod-query" class="input" autocomplete="off">
          <div id="prod-list" class="autocomplete-list"></div>
        </div>
      </div>

      <div class="field">
        <label>Quantidade</label>
        <input id="prod-qtd" class="input" type="number" min="1" value="1">
      </div>

      <button id="btn-add-item" class="btn btn-teal"><i class="fa-solid fa-plus icon-sm"></i> Adicionar</button>

    </div>

    <div class="table-wrap" style="margin-top:1rem">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Modalidade</th>
            <th class="text-center">Qtd</th>
            <th class="text-right">Valor Unit.</th>
            <th class="text-right">Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="itens-tbody"></tbody>
      </table>
    </div>
  </div><br>

  <!-- ================= FRETE ================= -->
  <div class="card">
    <div class="card-title">Frete e Endereço de Entrega</div>

    <div class="delivery-settings-bar">
      <div id="entrega-config-status" class="muted" role="status" aria-live="polite">Carregando configurações de entrega...</div>
      <button class="btn btn-blue" type="button" id="btn-config-entrega" aria-expanded="false" aria-controls="painel-config-entrega">
        <i class="fa-solid fa-gear icon-sm"></i> Configurações de entrega
      </button>
    </div>

    <section id="painel-config-entrega" class="delivery-settings" hidden aria-label="Configurações de entrega">
      <h3>Origem padrão e regra de frete</h3>
      <p class="muted">A origem fica salva no sistema e será usada nos próximos pedidos. Não usamos a localização do navegador.</p>
      <div class="address-autocomplete">
        <label for="origem-config-query">Origem desta entrega</label>
        <input id="origem-config-query" class="input" autocomplete="off" maxlength="200"
               aria-autocomplete="list" aria-controls="origem-config-list"
               placeholder="Digite rua, bairro ou cidade para pesquisar">
        <ul id="origem-config-list" class="autocomplete-list address-suggestions" role="listbox" aria-live="polite" hidden></ul>
      </div>
      <div class="grid-3 address-fields">
        <div class="field"><label for="origem-config-rua">Logradouro</label><input id="origem-config-rua" class="input" maxlength="150"></div>
        <div class="field"><label for="origem-config-numero">Número</label><input id="origem-config-numero" class="input" maxlength="20"></div>
        <div class="field"><label for="origem-config-bairro">Bairro</label><input id="origem-config-bairro" class="input" maxlength="100"></div>
        <div class="field"><label for="origem-config-cidade">Cidade</label><input id="origem-config-cidade" class="input" maxlength="100"></div>
        <div class="field"><label for="origem-config-estado">Estado (UF)</label><input id="origem-config-estado" class="input" maxlength="2"></div>
        <div class="field"><label for="origem-config-cep">CEP</label><input id="origem-config-cep" class="input" maxlength="12"></div>
        <div class="field"><label for="origem-config-referencia">Complemento</label><input id="origem-config-referencia" class="input" maxlength="150"></div>
      </div>
      <div class="grid-3 delivery-rule-fields">
        <div class="field">
          <label for="regra-cobranca">Regra de cobrança</label>
          <select id="regra-cobranca" class="input">
            <option value="">Selecione</option>
            <option value="FIXO">Valor fixo por entrega</option>
            <option value="POR_KM">Valor por quilômetro</option>
            <option value="FIXO_POR_KM">Taxa inicial + valor por quilômetro</option>
          </select>
        </div>
        <div class="field delivery-rule-fixed"><label for="frete-valor-fixo">Valor fixo (R$)</label><input id="frete-valor-fixo" class="input" type="number" min="0" step="0.01"></div>
        <div class="field delivery-rule-initial"><label for="frete-taxa-inicial">Taxa inicial (R$)</label><input id="frete-taxa-inicial" class="input" type="number" min="0" step="0.01"></div>
        <div class="field delivery-rule-km"><label for="frete-valor-km">Valor por km (R$)</label><input id="frete-valor-km" class="input" type="number" min="0" step="0.01"></div>
        <div class="field"><label for="frete-minimo">Taxa mínima opcional (R$)</label><input id="frete-minimo" class="input" type="number" min="0" step="0.01"></div>
        <div class="field"><label for="frete-distancia-maxima">Distância máxima opcional (km)</label><input id="frete-distancia-maxima" class="input" type="number" min="0.01" step="0.01"></div>
        <div class="field">
          <label for="sentido-distancia">Distância cobrada</label>
          <select id="sentido-distancia" class="input">
            <option value="IDA">Somente ida</option>
            <option value="IDA_VOLTA">Ida e volta (rotas calculadas separadamente)</option>
          </select>
        </div>
      </div>
      <div class="delivery-settings-actions">
        <button class="btn btn-teal" type="button" id="btn-salvar-config-entrega"><i class="fa-solid fa-floppy-disk icon-sm"></i> Salvar configurações</button>
        <div id="config-entrega-feedback" role="status" aria-live="polite"></div>
      </div>
    </section>

    <div class="field address-autocomplete">
      <label for="end-rua">Endereço de entrega</label>
      <input id="end-rua" class="input" autocomplete="off" maxlength="150"
             aria-autocomplete="list" aria-controls="end-list"
             placeholder="Digite rua, bairro ou cidade (mínimo 3 caracteres)">
      <ul id="end-list" class="autocomplete-list address-suggestions" role="listbox" aria-live="polite" hidden></ul>
    </div>

    <div class="grid-3 address-fields">
      <div class="field">
        <label for="end-numero">Número</label>
        <input id="end-numero" class="input" maxlength="10" autocomplete="address-line2">
      </div>
      <div class="field">
        <label for="end-bairro">Bairro</label>
        <input id="end-bairro" class="input" maxlength="100">
      </div>
      <div class="field">
        <label for="end-cidade">Cidade</label>
        <input id="end-cidade" class="input" maxlength="100">
      </div>
      <div class="field">
        <label for="end-estado">Estado</label>
        <input id="end-estado" class="input" maxlength="2">
      </div>
      <div class="field">
        <label for="end-cep">CEP</label>
        <input id="end-cep" class="input" maxlength="12" autocomplete="postal-code">
      </div>
      <div class="field">
        <label for="end-referencia">Complemento / referência</label>
        <input id="end-referencia" class="input" placeholder="Apto, bloco, salão ou ponto de referência" maxlength="150">
      </div>
    </div>

    <button class="btn" type="button" id="btn-cadastrar-endereco">
      <i class="fa-solid fa-location-dot icon-sm"></i> Salvar endereço
    </button>
    <p class="address-lookup-note">Sugestões fornecidas pelo Photon, com dados do OpenStreetMap. © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>.</p>

    <div class="grid-3" style="margin-top:1rem; align-items:end">
      <div class="field">
        <label for="distancia-km">Distância considerada no frete (km)</label>
        <input id="distancia-km" class="input" type="number" min="0" step="0.01" value="" readonly>
      </div>
      <div class="field">
        <label for="frete">Frete calculado (R$)</label>
        <input id="frete" class="input" type="number" min="0" step="0.01" value="" readonly>
      </div>
      <button id="btn-calc-frete" class="btn btn-blue" type="button">
        <i class="fa-solid fa-route icon-sm"></i> Calcular rota e frete
      </button>
    </div>

    <div id="info-frete" class="info-frete" style="margin-top:8px;" role="status" aria-live="polite"></div>
    <div id="resumo-rota" class="route-summary" aria-live="polite">Configure a origem padrão e selecione o destino para calcular a distância pelas vias.</div>
  </div><br>

  <!-- ================= PAGAMENTO ================= -->
  <div class="card">
    <div class="card-title">Pagamento e Observações</div>

    <div class="grid-3">

      <div class="field">
        <label>Desconto (R$)</label>
        <input id="desconto" class="input" type="number" min="0" step="0.01" value="0">
      </div>

      <div class="field">
        <label>Valor Pago (R$)</label>
        <input id="pago" class="input" type="number" min="0" step="0.01" value="0">
      </div>

      <div class="field">
        <label>Forma de Pagamento</label>
        <select id="forma-pagamento" class="input">
          <option value="PIX">PIX</option>
          <option value="DINHEIRO">Dinheiro</option>
          <option value="CARTAO_DEBITO">Cartão Débito</option>
          <option value="CARTAO_CREDITO">Cartão Crédito</option>
          <option value="TRANSFERENCIA">Transferência</option>
        </select>
      </div>

      <div class="field" style="grid-column: span 3">
        <label>Observação do Pagamento</label>
        <input id="obs-pagamento" class="input">
      </div>

      <div class="field" style="grid-column: span 3">
        <label>Observações do Pedido</label>
        <textarea id="observacoes" class="input" rows="5"></textarea>
      </div>

    </div>
  </div><br>

  <!-- ================= RESUMO ================= -->
  <div class="card">
    <div class="card-title">Resumo do Pedido</div>

    <div class="resumo">
      <div class="resumo-row"><span>Valor dos Produtos</span><span id="r-produtos">R$ 0,00</span></div>
      <div class="resumo-row"><span>Frete</span><span id="r-frete">R$ 0,00</span></div>
      <div class="resumo-row"><span>Desconto</span><span id="r-desconto">- R$ 0,00</span></div>
      <div class="resumo-row"><span>Valor Pago</span><span id="r-pago">R$ 0,00</span></div>
      <div class="resumo-row"><span>Valor Restante</span><span id="r-restante">R$ 0,00</span></div>
      <div class="resumo-total"><span>Total</span><span id="r-total">R$ 0,00</span></div>
    </div><br>

    <!-- ================= AÇÕES ================= -->
    <div class="actions">

    <button
      id="btn-salvar-pedido"
      class="btn btn-green">
      <i class="fa-solid fa-floppy-disk icon-sm"></i> Salvar
    </button>
    </div>

  </div>

    <!-- =====================================================================
      HTML DO MODAL
      ===================================================================== -->
  <div class="mp-overlay" id="modal-pedido" role="dialog" aria-modal="true" aria-labelledby="mp-titulo">
    <div class="mp-modal">

      <!-- 1. CABEÇALHO -->
      <header class="mp-header">
        <h2 id="mp-titulo"><i class="fa-solid fa-file-invoice icon-sm"></i> Confirmar Pedido</h2>
        <span class="mp-badge mp-badge--blue" id="mp-tipo-pedido">Aluguel</span>
        <span class="mp-spacer"></span>
        <button class="mp-close" data-mp-close aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button>
      </header>

      <!-- CORPO -->
      <div class="mp-body">

        <!-- 2. CLIENTE -->
        <section class="mp-card">
          <h3 class="mp-card-title"><i class="fa-solid fa-user icon-sm"></i> Cliente</h3>
          <div class="mp-grid">
            <div class="mp-field"><label>Nome</label><span id="mp-cli-nome">—</span></div>
            <div class="mp-field"><label>Telefone</label><span id="mp-cli-tel">—</span></div>
            <div class="mp-field"><label>Telefone para contato</label><span id="mp-cli-tel2">—</span></div>
            <div class="mp-field"><label>Endereço completo</label><span id="mp-cli-end">—</span></div>
            <div class="mp-field"><label>Cidade</label><span id="mp-cli-cidade">—</span></div>
            <div class="mp-field"><label>Estado</label><span id="mp-cli-uf">—</span></div>
            <div class="mp-field"><label>Data do evento</label><span id="mp-data-evento">—</span></div>
            <div class="mp-field"><label>Data da entrega</label><span id="mp-data-entrega">—</span></div>
            <div class="mp-field"><label>Data da retirada</label><span id="mp-data-retirada">—</span></div>
          </div>
        </section>

        <!-- 3. PRODUTOS -->
        <section class="mp-card">
          <h3 class="mp-card-title"><i class="fa-solid fa-box icon-sm"></i> Produtos</h3>
          <div class="mp-table-wrap">
            <table class="mp-table">
              <thead>
                <tr>
                  <th>Produto</th>
                  <th class="mp-num">Qtd</th>
                  <th class="mp-num">Valor unit.</th>
                  <th class="mp-num">Subtotal</th>
                </tr>
              </thead>
              <tbody id="mp-produtos"></tbody>
            </table>
          </div>
          <div class="mp-table-foot">
            <span>Total de itens: <b id="mp-total-itens">0</b></span>
            <span>Valor dos produtos: <strong id="mp-total-produtos">R$ 0,00</strong></span>
          </div>
        </section>

        <!-- 4. FRETE -->
        <section class="mp-card" id="mp-card-frete">
          <h3 class="mp-card-title"><i class="fa-solid fa-location-dot icon-sm"></i> Rota e Endereço de Entrega</h3>
          <div class="mp-grid">
            <div class="mp-field" style="grid-column:1/-1"><label>Origem informada para este pedido</label><span id="mp-fr-origem">—</span></div>
            <div class="mp-field"><label>Rua</label><span id="mp-fr-rua">—</span></div>
            <div class="mp-field"><label>Número</label><span id="mp-fr-num">—</span></div>
            <div class="mp-field"><label>Bairro</label><span id="mp-fr-bairro">—</span></div>
            <div class="mp-field"><label>Cidade</label><span id="mp-fr-cidade">—</span></div>
            <div class="mp-field"><label>Estado</label><span id="mp-fr-uf">—</span></div>
            <div class="mp-field"><label>CEP</label><span id="mp-fr-cep">—</span></div>
            <div class="mp-field"><label>Complemento / referência</label><span id="mp-fr-referencia">—</span></div>
            <div class="mp-field"><label>Distância</label><span id="mp-fr-km">—</span></div>
            <div class="mp-field"><label>Regra aplicada</label><span id="mp-fr-formula">—</span></div>
            <div class="mp-field"><label>Valor do frete</label><span id="mp-fr-valor">—</span></div>
          </div>
        </section>

        <!-- 5. PAGAMENTO -->
        <section class="mp-card">
          <h3 class="mp-card-title"><i class="fa-solid fa-dollar-sign icon-sm"></i> Pagamento</h3>
          <div class="mp-grid">
            <div class="mp-field"><label>Forma de pagamento</label><span id="mp-pg-forma">—</span></div>
            <div class="mp-field"><label>Valor pago</label><span id="mp-pg-pago">—</span></div>
            <div class="mp-field"><label>Desconto</label><span id="mp-pg-desc" class="mp-text-verde">—</span></div>
            <div class="mp-field"><label>Valor restante</label><span id="mp-pg-restante">—</span></div>
            <div class="mp-field" style="grid-column:1/-1"><label>Observação do pagamento</label><span id="mp-pg-obs">—</span></div>
          </div>
          <div style="margin-top:12px" id="mp-pg-badge"></div>
        </section>

        <!-- 6. OBSERVAÇÕES (oculto automaticamente se vazio) -->
        <section class="mp-card" id="mp-card-obs" hidden>
          <h3 class="mp-card-title"><i class="fa-solid fa-pen icon-sm"></i> Observações</h3>
          <p id="mp-obs" style="margin:0; font-size:.92rem; line-height:1.6;"></p>
        </section>

        <!-- 7. RESUMO FINANCEIRO -->
        <section class="mp-summary">
          <div class="mp-line"><span>Valor dos produtos</span><b id="mp-rs-produtos">R$ 0,00</b></div>
          <div class="mp-line"><span>Frete</span><b id="mp-rs-frete">R$ 0,00</b></div>
          <div class="mp-line"><span>Desconto</span><b id="mp-rs-desc" class="mp-text-green">- R$ 0,00</b></div>
          <div class="mp-line"><span>Valor pago</span><b id="mp-rs-pago">R$ 0,00</b></div>
          <div class="mp-line"><span>Valor restante</span><b id="mp-rs-restante" class="mp-text-red">R$ 0,00</b></div>
          <div class="mp-total"><span>Total geral</span><b id="mp-rs-total">R$ 0,00</b></div>
        </section>

        <!-- 8. STATUS -->
        <div class="mp-status-row" id="mp-status"></div>
      </div>

      <!-- 9. RODAPÉ -->
      <footer class="mp-footer">
        <button class="mp-btn mp-btn--gray"  data-mp-close><i class="fa-solid fa-xmark"></i> Cancelar</button>
        <button class="mp-btn mp-btn--green" id="btn-confirmar-modal"><i class="fa-solid fa-check"></i> Confirmar Pedido</button>
        <button class="mp-btn mp-btn--blue"  id="btn-gerar-orcamento-modal"><i class="fa-solid fa-file-invoice-dollar"></i> Gerar Orçamento</button>
        <button class="mp-btn mp-btn--dark"  id="btn-imprimir-pedido"><i class="fa-solid fa-print"></i> Imprimir</button>
      </footer>
    </div>
  </div>

</div>



<script type="module" src="/js/pedidos/index.js"></script>

<script>
const ModalPedido = (() => {

  const overlay = document.getElementById("modal-pedido");
  const $ = id => document.getElementById(id);

  /* ================= Helpers ================= */

  const brl = valor =>
    (Number(valor) || 0).toLocaleString("pt-BR", {
      style: "currency",
      currency: "BRL"
    });

  const set = (id, valor) => {
    const el = $(id);
    if (el) {
      el.textContent = valor ?? "—";
    }
  };

  /* ================= Preencher Modal ================= */

  function preencher(p = {}) {

    const cli = p.cliente || {};
    const fr = p.frete || {};
    const pg = p.pagamento || {};
    const itens = p.itens || [];

    /* ---------- Tipo ---------- */

    set("mp-tipo-pedido", p.tipo || "Pedido");

    /* ---------- Cliente ---------- */

    set("mp-cli-nome", cli.nome);
    set("mp-cli-tel", cli.telefone);
    set("mp-cli-tel2", cli.telefoneContato);
    set("mp-cli-end", cli.endereco);
    set("mp-cli-cidade", cli.cidade);
    set("mp-cli-uf", cli.estado);

    set("mp-data-evento", p.dataEvento);
    set("mp-data-entrega", p.dataEntrega);
    set("mp-data-retirada", p.dataRetirada);

    /* ---------- Produtos ---------- */

    const tbody = $("mp-produtos");

    let totalProdutos = 0;
    let totalItens = 0;

    if (tbody) {

      tbody.innerHTML = "";

      itens.forEach(item => {

        const subtotal = (item.qtd || 0) * (item.valor || 0);

        totalProdutos += subtotal;
        totalItens += Number(item.qtd || 0);

        const tr = document.createElement("tr");

        tr.innerHTML = `
          <td>${item.nome || ""}</td>
          <td class="mp-num">${item.qtd || 0}</td>
          <td class="mp-num">${brl(item.valor)}</td>
          <td class="mp-num"><strong>${brl(subtotal)}</strong></td>
        `;

        tbody.appendChild(tr);

      });

    }

    set("mp-total-itens", totalItens);
    set("mp-total-produtos", brl(totalProdutos));

    /* ---------- Frete ---------- */

    const frete = Number(fr.valor) || 0;

    set("mp-fr-origem", fr.origem);
    set("mp-fr-rua", fr.rua);
    set("mp-fr-num", fr.numero);
    set("mp-fr-bairro", fr.bairro);
    set("mp-fr-cidade", fr.cidade);
    set("mp-fr-uf", fr.estado);
    set("mp-fr-cep", fr.cep);
    set("mp-fr-referencia", fr.referencia);

    set(
      "mp-fr-km",
      fr.km != null ? `${Number(fr.km).toFixed(2)} km` : "—"
    );
    set("mp-fr-formula", fr.formula);

    const valorFrete = $("mp-fr-valor");
    if (valorFrete) {
      valorFrete.innerHTML = frete > 0
        ? brl(frete)
        : '<span class="mp-badge mp-badge--green"><i class="fa-solid fa-truck"></i> Frete Grátis</span>';

    }

    /* ---------- Pagamento ---------- */

    const desconto = Number(pg.desconto) || 0;
    const pago = Number(pg.pago) || 0;

    const total = totalProdutos + frete - desconto;
    const restante = Math.max(total - pago, 0);

    set("mp-pg-forma", pg.forma);
    set("mp-pg-pago", brl(pago));

    const desc = $("mp-pg-desc");

    if (desc) {
      desc.textContent = "- " + brl(desconto);
      desc.style.color = "var(--mp-green)";
    }

    const restanteEl = $("mp-pg-restante");

    if (restanteEl) {
      restanteEl.textContent = brl(restante);
      restanteEl.style.color =
        restante > 0
          ? "var(--mp-red)"
          : "var(--mp-green)";
    }

    set("mp-pg-obs", pg.observacao || "—");
    const badge = $("mp-pg-badge");
    if (badge) {

      badge.innerHTML = restante === 0
        ? '<span class="mp-badge mp-badge--green"><i class="fa-solid fa-circle-check"></i> Pagamento Completo</span>'
        : "";
    }

    /* ---------- Observações ---------- */

    const obs = (p.observacoes || "").trim();

    const cardObs = $("mp-card-obs");
    if (cardObs) {
      cardObs.hidden = !obs;
    }

    set("mp-obs", obs);
    /* ---------- Resumo ---------- */
    set("mp-rs-produtos", brl(totalProdutos));
    set(
      "mp-rs-frete",
      frete > 0 ? brl(frete) : "Grátis"
    );

    set("mp-rs-desc", "- " + brl(desconto));
    set("mp-rs-pago", brl(pago));
    set("mp-rs-restante", brl(restante));
    set("mp-rs-total", brl(total));

    /* ---------- Status ---------- */

    const status = [];

    if (restante === 0) {

      status.push(["green", "<i class=\"fa-solid fa-circle-check\"></i> Pedido Completo"]);

    } else if (pago > 0) {

      status.push(["amber", "<i class=\"fa-solid fa-clock\"></i> Pagamento Parcial"]);

    } else {
      status.push(["red", "<i class=\"fa-solid fa-triangle-exclamation\"></i> Pagamento Pendente"]);
    }

    status.push(
      frete > 0
        ? ["blue", "<i class=\"fa-solid fa-truck\"></i> Frete Calculado"]
        : ["slate", "<i class=\"fa-solid fa-box\"></i> Sem Frete"]
    );

    status.push(
      p.orcamento
        ? ["slate", "<i class=\"fa-solid fa-file-invoice-dollar\"></i> Orçamento"]
        : ["dark", "<i class=\"fa-solid fa-file-invoice\"></i> Pedido"]
    );

    const statusEl = $("mp-status");

    if (statusEl) {

      statusEl.innerHTML = status
        .map(([cor, texto]) =>
          `<span class="mp-badge mp-badge--${cor}">${texto}</span>`
        )
        .join("");
    }
  }

  /* ================= Abrir ================= */

  function abrir(dados = {}) {
    preencher(dados);
    if (overlay) {

      overlay.classList.add("is-open");

      document.body.style.overflow = "hidden";
    }
  }

  /* ================= Fechar ================= */

  function fechar() {

    if (overlay) {

      overlay.classList.remove("is-open");

      document.body.style.overflow = "";
    }
  }

  /* ================= Eventos ================= */

  if (overlay) {

    overlay.addEventListener("click", e => {

      if (
        e.target === overlay ||
        e.target.closest("[data-mp-close]")
      ) {
        fechar();
      }
    });
  }

  document.addEventListener("keydown", e => {

    if (
      e.key === "Escape" &&
      overlay &&
      overlay.classList.contains("is-open")
    ) {

      fechar();
    }
  });

  /* ================= Ripple ================= */

  document.querySelectorAll(".mp-btn").forEach(btn => {

    btn.addEventListener("click", e => {

      const ripple = document.createElement("span");

      const size = Math.max(
        btn.offsetWidth,
        btn.offsetHeight
      );

      const rect = btn.getBoundingClientRect();

      ripple.className = "mp-ripple";

      ripple.style.width = size + "px";
      ripple.style.height = size + "px";

      ripple.style.left =
        e.clientX - rect.left - size / 2 + "px";

      ripple.style.top =
        e.clientY - rect.top - size / 2 + "px";

      btn.appendChild(ripple);

      setTimeout(() => ripple.remove(), 600);
    });
  });

  /* ================= Botão Imprimir ================= */

  return {
    abrir,
    fechar,
    preencher
};

})();

window.ModalPedido = ModalPedido;
</script>




