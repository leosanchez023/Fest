// ==========================================
// CARREGAR PRODUTOS
// ==========================================

async function carregarProdutos(){

    try{


        const params = new URLSearchParams();
        const busca = document.getElementById("busca")?.value || "";
        const categoria = document.getElementById("filtro-categoria")?.value || "";
        const fornecedor = document.getElementById("filtro-fornecedor")?.value || "";
        const status = document.getElementById("filtro-status")?.value || "";
        if (busca) params.set("busca", busca);
        if (categoria) params.set("categoria", categoria);
        if (fornecedor) params.set("fornecedor", fornecedor);
        if (status) params.set("status", status);

        const resposta = await fetch(`/produtos/api?${params}`);


        const produtos = await resposta.json();



        renderProdutos(produtos);



    }catch(error){

        console.error(
            "Erro ao carregar produtos:",
            error
        );

    }

}





// ==========================================
// DASHBOARD
// ==========================================

async function carregarDashboard(){


    try{


        const resposta = await fetch(
            "/produtos/api/dashboard"
        );


        const dados = await resposta.json();



        document.getElementById(
            "kpi-total"
        ).textContent =
            dados.total || 0;



        document.getElementById(
            "kpi-disponivel"
        ).textContent =
            dados.disponiveis || 0;



        document.getElementById(
            "kpi-reservados"
        ).textContent =
            dados.reservados || 0;



        document.getElementById(
            "kpi-manutencao"
        ).textContent =
            dados.manutencao || 0;



        document.getElementById(
            "kpi-danificados"
        ).textContent =
            dados.danificados || 0;



        document.getElementById(
            "kpi-baixo-estoque"
        ).textContent =
            dados.baixo_estoque || 0;



        document.getElementById(
            "kpi-valor-estoque"
        ).textContent =
            brl(dados.valor_estoque);



    }catch(error){

        console.error(
            "Erro dashboard:",
            error
        );

    }


}




// ==========================================
// BUSCA
// ==========================================

document
.getElementById("busca")
.addEventListener("input", async function(){


    const busca = this.value;



    await carregarProdutos();



});

document.querySelectorAll("#filtro-categoria, #filtro-fornecedor, #filtro-status")
    .forEach((filtro) => filtro.addEventListener("change", carregarProdutos));

async function carregarFornecedores() {
    const select = document.getElementById("filtro-fornecedor");
    const resposta = await fetch("/fornecedores/data");
    const fornecedores = await resposta.json();
    if (select) select.innerHTML = '<option value="">Todos os fornecedores</option>' + fornecedores
        .filter((fornecedor) => fornecedor.status === "Ativo")
        .map((fornecedor) => `<option value="${fornecedor.id}">${fornecedor.nome}</option>`)
        .join("");

    const lista = document.getElementById("fornecedores-list");
    if (lista) {
        lista.innerHTML = fornecedores
            .filter((fornecedor) => fornecedor.status === "Ativo")
            .map((fornecedor) => `<option value="${fornecedor.nome}" data-id="${fornecedor.id}"></option>`)
            .join("");
    }
}

function configurarFornecedor() {
    const campo = document.getElementById("produto-fornecedor");
    const id = document.getElementById("produto-fornecedor-id");
    const lista = document.getElementById("fornecedores-list");
    if (!campo || !id || !lista) return;

    const atualizarId = () => {
        const opcao = Array.from(lista.options).find((item) => item.value === campo.value.trim());
        id.value = opcao?.dataset.id || "";
    };
    campo.addEventListener("input", atualizarId);
    campo.addEventListener("change", atualizarId);
}

function alternarMenuProduto(id) {
    document.querySelectorAll(".product-menu").forEach((menu) => {
        if (menu.id !== `menu-produto-${id}`) menu.hidden = true;
    });
    const menu = document.getElementById(`menu-produto-${id}`);
    if (menu) menu.hidden = !menu.hidden;
}

function editarProduto(id) {
    window.location.href = `/produtos/editar/${id}`;
}

async function visualizarProduto(id) {
    const resposta = await fetch(`/produtos/api/${id}`);
    const produto = await resposta.json();
    if (!resposta.ok) return window.FestAlert?.error?.("Produto", produto.erro || "Produto não encontrado.");
    await window.FestAlert?.info?.("Produto", `${produto.nome}\nCategoria: ${produto.categoria || "-"}\nFornecedor: ${produto.fornecedor || "-"}\nEstoque: ${produto.estoque || 0}`);
}

async function alterarPrecoProduto(id) {
    const resposta = await fetch(`/produtos/api/${id}`);
    const produto = await resposta.json();
    if (!resposta.ok) return window.FestAlert?.error?.("Produto", produto.erro || "Produto não encontrado.");
    const preco = prompt("Novo preço de locação:", produto.preco_aluguel || 0);
    if (preco === null) return;
    const dados = new URLSearchParams({
        nome: produto.nome,
        codigo: produto.codigo || "",
        categoria: produto.categoria || "",
        fornecedor_id: produto.fornecedor_id || "",
        estoque: produto.estoque || 0,
        precoVenda: produto.preco_venda || 0,
        precoAluguel: preco,
        estoque_minimo: produto.estoque_minimo || 0
    });
    const atualizacao = await fetch(`/produtos/editar/${id}`, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: dados
    });
    if (atualizacao.ok) window.location.reload();
    else await window.FestAlert?.error?.("Erro no preço", "Não foi possível alterar o preço.");
}





// ==========================================
// FILTRO STATUS
// ==========================================

document
.querySelectorAll("#chips .chip")
.forEach(chip => {



    chip.addEventListener(
    "click",
    async()=>{


        document
        .querySelectorAll("#chips .chip")
        .forEach(c =>
            c.classList.remove("active")
        );



        chip.classList.add("active");



        const status =
            chip.dataset.status;



        const resposta = await fetch(

            `/produtos/api?status=${status}`

        );



        const produtos =
            await resposta.json();



        renderProdutos(produtos);



    });



});





// ==========================================
// SAÍDA ESTOQUE
// ==========================================

async function baixarEstoque(id){


    const quantidade =
        prompt(
            "Digite a quantidade para saída:"
        );



    if(!quantidade)
        return;



    await fetch(

        `/produtos/${id}/saida`,

        {

            method:"POST",

            headers:{

                "Content-Type":
                "application/json"

            },


            body:JSON.stringify({

                quantidade

            })

        }

    );



    carregarProdutos();

    carregarDashboard();


}






// ==========================================
// INICIALIZAÇÃO
// ==========================================


carregarProdutos();

carregarDashboard();

carregarFornecedores();
configurarFornecedor();


