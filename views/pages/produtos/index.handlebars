// ==========================================
// BUSCA
// ==========================================

document
.getElementById("busca")
.addEventListener("input", async function(){


    const busca = this.value;



    await carregarProdutos();



});

document.querySelectorAll("#filtro-categoria, #filtro-fornecedor, #filtro-status")
    .forEach((filtro) => filtro.addEventListener("change", carregarProdutos));

async function carregarFornecedores() {
    const select = document.getElementById("filtro-fornecedor");
    const resposta = await fetch("/fornecedores/data");
    const fornecedores = await resposta.json();
    if (select) select.innerHTML = '<option value="">Todos os fornecedores</option>' + fornecedores
        .filter((fornecedor) => fornecedor.status === "Ativo")
        .map((fornecedor) => `<option value="${fornecedor.id}">${fornecedor.nome}</option>`)
        .join("");

    const lista = document.getElementById("fornecedores-list");
    if (lista) {
        lista.innerHTML = fornecedores
            .filter((fornecedor) => fornecedor.status === "Ativo")
            .map((fornecedor) => `<option value="${fornecedor.nome}" data-id="${fornecedor.id}"></option>`)
            .join("");
    }
}

function configurarFornecedor() {
    const campo = document.getElementById("produto-fornecedor");
    const id = document.getElementById("produto-fornecedor-id");
    const lista = document.getElementById("fornecedores-list");
    if (!campo || !id || !lista) return;

    const atualizarId = () => {
        const opcao = Array.from(lista.options).find((item) => item.value === campo.value.trim());
        id.value = opcao?.dataset.id || "";
    };
    campo.addEventListener("input", atualizarId);
    campo.addEventListener("change", atualizarId);
}

function alternarMenuProduto(id) {
    document.querySelectorAll(".product-menu").forEach((menu) => {
        if (menu.id !== `menu-produto-${id}`) menu.hidden = true;
    });
    const menu = document.getElementById(`menu-produto-${id}`);
    if (menu) menu.hidden = !menu.hidden;
}

function editarProduto(id) {
    window.location.href = `/produtos/editar/${id}`;
}

async function visualizarProduto(id) {
    const resposta = await fetch(`/produtos/api/${id}`);
    const produto = await resposta.json();
    if (!resposta.ok) return alert(produto.erro || "Produto não encontrado.");
    alert(`${produto.nome}\nCategoria: ${produto.categoria || "-"}\nFornecedor: ${produto.fornecedor || "-"}\nEstoque: ${produto.estoque || 0}`);
}

async function alterarPrecoProduto(id) {
    const resposta = await fetch(`/produtos/api/${id}`);
    const produto = await resposta.json();
    if (!resposta.ok) return alert(produto.erro || "Produto não encontrado.");
    const preco = prompt("Novo preço de locação:", produto.preco_aluguel || 0);
    if (preco === null) return;
    const dados = new URLSearchParams({
        nome: produto.nome,
        codigo: produto.codigo || "",
        categoria: produto.categoria || "",
        tipo: produto.tipo || "",
        fornecedor_id: produto.fornecedor_id || "",
        estoque: produto.estoque || 0,
        precoVenda: produto.preco_venda || 0,
        precoAluguel: preco,
        estoque_minimo: produto.estoque_minimo || 0
    });
    const atualizacao = await fetch(`/produtos/editar/${id}`, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: dados
    });
    if (atualizacao.ok) window.location.reload();
    else alert("Não foi possível alterar o preço.");
}





