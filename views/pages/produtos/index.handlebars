<div id="aba-cadastro" class="tab-content" style="display:none;">

    <div class="container">

        <div class="page-meta" data-title="Produtos" data-subtitle="Gerencie produtos, preços e disponibilidade"></div>

        <!-- FORM -->
        <div class="card">

            <form action="{{#if produto}}/produtos/editar/{{produto.id}}{{else}}/produtos/criar{{/if}}" method="POST">

                <div class="form-grid">

                    <div>
                        <label>Código do Produto</label>
                        <input
                            name="codigo"
                            placeholder="Ex: MES-001"
                            value="{{produto.codigo}}"
                            maxlength="50"
                        >
                    </div>

                    <div>
                        <label>Nome do Produto</label>
                        <input
                            name="nome"
                            placeholder="Ex: Mesa redonda"
                            value="{{produto.nome}}"
                        >
                    </div>

                    <div>
                        <label>Categoria</label>

                        <input
                            name="categoria"
                            list="categorias-list"
                            placeholder="Ex: Mesas, Cadeiras, Decoração..."
                            value="{{produto.categoria}}"
                        >

                        <datalist id="categorias-list">
                            {{#each categorias}}
                                <option value="{{this}}"></option>
                            {{/each}}
                        </datalist>

                    </div>

                    <div>
                        <label>Tipo</label>

                        <select name="tipo">
                            <option {{#if (eq produto.tipo "Venda")}}selected{{/if}}>Venda</option>
                            <option {{#if (eq produto.tipo "Aluguel")}}selected{{/if}}>Aluguel</option>
                            <option {{#if (eq produto.tipo "Ambos")}}selected{{/if}}>Ambos</option>
                        </select>

                    </div>

                    <div>
                        <label>Fornecedor</label>
                        <input
                            id="produto-fornecedor"
                            name="fornecedor_nome"
                            list="fornecedores-list"
                            placeholder="Digite para pesquisar"
                            value="{{produto.fornecedor}}"
                            autocomplete="off"
                        >
                        <input type="hidden" id="produto-fornecedor-id" name="fornecedor_id" value="{{produto.fornecedor_id}}">
                        <datalist id="fornecedores-list">
                            {{#each fornecedores}}
                                <option value="{{this.nome}}" data-id="{{this.id}}"></option>
                            {{/each}}
                        </datalist>
                        <a href="/fornecedores" target="_blank" rel="noopener">Cadastrar novo fornecedor</a>
                    </div>

                    <div>
                        <label>Localização</label>
                        <input name="localizacao" value="{{produto.localizacao}}" placeholder="Ex: Galpão A">
                    </div>

                    <div>
                        <label>Estoque</label>

                        <input
                            name="estoque"
                            type="number"
                            min="0"
                            value="{{produto.estoque}}"
                        >
                    </div>

                    <div>
                        <label>Preço Venda (R$)</label>

                        <input
                            name="precoVenda"
                            type="number"
                            min="0"
                            step="0.01"
                            value="{{produto.preco_venda}}"
                        >
                    </div>

                    <div>
                        <label>Preço Aluguel (R$)</label>

                        <input
                            name="precoAluguel"
                            type="number"
                            min="0"
                            step="0.01"
                            value="{{produto.preco_aluguel}}"
                        >
                    </div>

                    <div>
                        <label>Estoque mínimo</label>
                        <input name="estoque_minimo" type="number" min="0" value="{{produto.estoque_minimo}}">
                    </div>

                </div>

                <div class="btn-group">

                    <button class="btn btn-primary" type="submit">
                        {{#if produto}}
                            Atualizar
                        {{else}}
                            Salvar
                        {{/if}}
                    </button>

                    <a href="/produtos" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

        <!-- FILTRO + TABELA -->

        <div class="card">

            <form method="GET" action="/produtos" class="filtro-bar">

                <input
                    type="text"
                    name="busca"
                    placeholder="Buscar por nome..."
                    value="{{filtros.busca}}"
                >

                <select name="categoria">

                    <option value="">Todas as categorias</option>

                    {{#each categorias}}
                        <option
                            value="{{this}}"
                            {{#if (eq ../filtros.categoria this)}}selected{{/if}}
                        >
                            {{this}}
                        </option>
                    {{/each}}

                </select>

                <button class="btn btn-primary" type="submit">
                    Filtrar
                </button>

                <a href="/produtos" class="btn btn-secondary">
                    Limpar
                </a>

            </form>

            <table>

                <thead>

                    <tr>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Estoque</th>
                        <th>Venda (R$)</th>
                        <th>Aluguel (R$)</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    {{#each produtos}}

                    <tr>

                        <td>{{this.nome}}</td>
                        <td>{{this.categoria}}</td>
                        <td>{{this.estoque}}</td>
                        <td>{{moeda this.preco_venda}} R$</td>
                        <td>{{moeda this.preco_aluguel}} R$</td>

                        <td class="actions">

                            <a href="/produtos/editar/{{this.id}}" class="btn-edit">
                                Editar
                            </a>

                            <button
                                type="button"
                                onclick="deletarProduto({{this.id}})"
                                class="btn-delete"
                            >
                                Excluir
                            </button>

                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>

            {{#unless produtos.length}}

                <div class="empty">
                    Nenhum produto encontrado.
                </div>

            {{/unless}}

        </div>

    </div>

</div>



