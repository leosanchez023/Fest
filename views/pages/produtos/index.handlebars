        .forEach(c =>
            c.classList.remove("active")
        );



        chip.classList.add("active");



        const status =
            chip.dataset.status;



        const resposta = await fetch(

            `/produtos/api?status=${status}`

        );



        const produtos =
            await resposta.json();



        renderProdutos(produtos);



    });



});





// ==========================================
// SAÍDA ESTOQUE
// ==========================================

async function baixarEstoque(id){


    const quantidade =
        prompt(
            "Digite a quantidade para saída:"
        );



    if(!quantidade)
        return;



    await fetch(

        `/produtos/${id}/saida`,

        {

            method:"POST",

            headers:{

                "Content-Type":
                "application/json"

            },


            body:JSON.stringify({

                quantidade

            })

        }

    );



    carregarProdutos();

    carregarDashboard();


}






// ==========================================
// ABAS
// ==========================================


const btnProdutos = document.querySelector('[data-tab="produtos"]');



const btnCadastro = document.querySelector('[data-tab="cadastro"]');



const abaProdutos =
document.getElementById(
    "aba-produtos"
);



const abaCadastro =
document.getElementById(
    "aba-cadastro"
);




function abrirAba(nome) {
    const cadastro = nome === "cadastro";
    document.querySelectorAll(".tab").forEach((tab) => tab.classList.toggle("active", tab.dataset.tab === nome));
    if (abaProdutos) abaProdutos.style.display = cadastro ? "none" : "block";
    if (abaCadastro) abaCadastro.style.display = cadastro ? "block" : "none";
}

if (btnProdutos) btnProdutos.addEventListener("click", () => abrirAba("produtos"));
if (btnCadastro) btnCadastro.addEventListener("click", () => abrirAba("cadastro"));






// ==========================================
// INICIALIZAÇÃO
// ==========================================


carregarProdutos();

carregarDashboard();

carregarFornecedores();
configurarFornecedor();


</script>