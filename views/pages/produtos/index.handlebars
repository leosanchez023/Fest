<div id="aba-cadastro" class="tab-content"{{#unless mostrarCadastro}}{{#unless produto}} style="display:none;"{{/unless}}{{/unless}}>

    <div class="container">

        <!-- FORM -->
        <div class="card">

            <form id="produto-form" action="{{#if produto}}/produtos/editar/{{produto.id}}{{else}}/produtos/criar{{/if}}" method="POST">

                {{#if produto}}
                    <div class="edit-mode-banner" role="status">
                        Editando: <strong>{{produto.nome}}</strong>
                    </div>
                {{/if}}

                <div class="form-grid">

                    <div>
                        <label>Código do Produto</label>
                        <input
                            name="codigo"
                            placeholder="Ex: MES-001"
                            value="{{produto.codigo}}"
                            maxlength="50"
                        >
                    </div>

                    <div>
                        <label>Nome do Produto</label>
                        <input
                            name="nome"
                            placeholder="Ex: Mesa redonda"
                            value="{{produto.nome}}"
                        >
                    </div>

                    <div>
                        <label>Categoria</label>

                        <input
                            name="categoria"
                            list="categorias-list"
                            placeholder="Ex: Mesas, Cadeiras, Decoração..."
                            value="{{produto.categoria}}"
                        >

                        <datalist id="categorias-list">
                            {{#each categorias}}
                                <option value="{{this}}"></option>
                            {{/each}}
                        </datalist>

                    </div>

                    <div>
                        <label>Fornecedor</label>
                        <input
                            id="produto-fornecedor"
                            name="fornecedor_nome"
                            list="fornecedores-list"
                            placeholder="Digite para pesquisar"
                            value="{{produto.fornecedor}}"
                            autocomplete="off"
                        >
                        <input type="hidden" id="produto-fornecedor-id" name="fornecedor_id" value="{{produto.fornecedor_id}}">
                        <datalist id="fornecedores-list">
                            {{#each fornecedores}}
                                <option value="{{this.nome}}" data-id="{{this.id}}"></option>
                            {{/each}}
                        </datalist>
                        <a href="/fornecedores" target="_blank" rel="noopener">Cadastrar novo fornecedor</a>
                    </div>

                    <div>
                        <label>Estoque</label>

                        <input
                            name="estoque"
                            id="produto-estoque"
                            type="number"
                            min="0"
                            value="{{produto.estoque}}"
                        >
                    </div>

                    <div>
                        <label for="produto-controla-estoque">Controle de estoque</label>
                        <select name="controla_estoque" id="produto-controla-estoque">
                            {{#if produto}}
                                <option value="1" {{#if produto.controla_estoque}}selected{{/if}}>Controlado</option>
                                <option value="0" {{#unless produto.controla_estoque}}selected{{/unless}}>Não controlado</option>
                            {{else}}
                                <option value="1" selected>Controlado</option>
                                <option value="0">Não controlado</option>
                            {{/if}}
                        </select>
                        <small>Desativado: o produto não gera movimentos nem limita disponibilidade.</small>
                    </div>

                    {{#if produto}}
                    <div class="field">
                        <label for="produto-ativo">Situação cadastral</label>
                        <select name="ativo" id="produto-ativo" required>
                          <option value="1" {{#if produto.ativo}}selected{{/if}}>Ativo</option>
                          <option value="0" {{#unless produto.ativo}}selected{{/unless}}>Inativo</option>
                        </select>
                        <small>A situação cadastral não altera a disponibilidade do estoque.</small>
                    </div>
                    {{/if}}

                    <div>
                        <label>Preço Venda (R$)</label>

                        <input
                            name="precoVenda"
                            type="number"
                            min="0"
                            step="0.01"
                            value="{{produto.preco_venda}}"
                        >
                    </div>

                    <div>
                        <label>Preço Aluguel (R$)</label>

                        <input
                            name="precoAluguel"
                            type="number"
                            min="0"
                            step="0.01"
                            value="{{produto.preco_aluguel}}"
                        >
                    </div>

                    <div>
                        <label>Estoque mínimo</label>
                        <input name="estoque_minimo" type="number" min="0" value="{{produto.estoque_minimo}}">
                    </div>

                </div>

                <div class="btn-group">

                    <button class="btn btn-primary" type="submit">
                        {{#if produto}}
                            Salvar alterações
                        {{else}}
                            Cadastrar
                        {{/if}}
                    </button>

                    <a href="/produtos/cadastro" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

        <!-- FILTRO + TABELA -->

        <div class="card">

            <form method="GET" action="/produtos" class="filtro-bar">

                <input
                    type="text"
                    name="busca"
                    placeholder="Buscar por nome..."
                    value="{{filtros.busca}}"
                >

                <select name="categoria">

                    <option value="">Todas as categorias</option>

                    {{#each categorias}}
                        <option
                            value="{{this}}"
                            {{#if (eq ../filtros.categoria this)}}selected{{/if}}
                        >
                            {{this}}
                        </option>
                    {{/each}}

                </select>

                <button class="btn btn-primary" type="submit">
                    Filtrar
                </button>

                <a href="/produtos" class="btn btn-secondary">
                    Limpar
                </a>

            </form>

            <div class="table-wrap">
            <table>

                <thead>

                    <tr>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Estoque</th>
                        <th>Disponível</th>
                        <th>Status</th>
                        <th>Venda (R$)</th>
                        <th>Aluguel (R$)</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    {{#each produtos}}

                    <tr>

                        <td>{{this.nome}}</td>
                        <td>{{this.categoria}}</td>
                        <td>{{this.estoque}}</td>
                        <td>{{this.disponivel}}</td>
                        <td><span class="badge badge-{{this.status_estoque_class}}">{{this.status_estoque_label}}</span></td>
                        <td><span class="badge {{#if this.ativo}}badge-success{{else}}badge-muted{{/if}}">{{#if this.ativo}}Ativo{{else}}Inativo{{/if}}</span></td>
                        <td>{{moeda this.preco_venda}} R$</td>
                        <td>{{moeda this.preco_aluguel}} R$</td>

                        <td class="actions">
                            <div class="actions product-actions">
                                <button class="iconbtn" type="button" aria-label="Ações do produto {{this.nome}}"
                                        aria-expanded="false" data-product-list-menu="{{this.id}}">
                                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                </button>
                                <div class="product-menu" id="menu-lista-produto-{{this.id}}" hidden>
                                    <a href="/produtos/editar/{{this.id}}">Editar produto</a>
                                    <button type="button" data-product-list-delete="{{this.id}}">Excluir produto</button>
                                </div>
                            </div>
                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>
            </div>

            {{#unless produtos.length}}

                <div class="empty">
                    Nenhum produto encontrado.
                </div>

            {{/unless}}

        </div>

    </div>

</div>


