<link rel="stylesheet" href="/css/pages/fornecedores.css">
<link rel="stylesheet" href="/css/components/record-table-actions.css">
<main class="main">
    <!-- Cabeçalho -->
    <div class="page-header">
        <div class="page-meta" data-title="Fornecedores" data-subtitle="Gerencie fornecedores e produtos relacionados"></div>

        <button id="btn-new-supplier" class="btn btn-primary" type="button"><i class="fa-solid fa-plus icon-sm"></i> Novo Fornecedor</button>
    </div>

    {{#if error}}
    <div class="supplier-message supplier-message-error" role="alert">{{error}}</div>
    {{/if}}

    <!-- Indicadores -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Total de Fornecedores</span>
            <span class="kpi-value" id="kpi-total">0</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Fornecedores Ativos</span>
            <span class="kpi-value" id="kpi-active">0</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Cadastros neste mês</span>
            <span class="kpi-value" id="kpi-new">0</span>
        </div>
    </div>

    <!-- Barra de Pesquisa -->
    <div class="toolbar supplier-filters" role="search" aria-label="Filtros de fornecedores">
        <input
            type="text"
            class="search-input"
            id="search"
            placeholder="Pesquisar fornecedor..."
            value="{{q}}"
        >

        <select id="filter-category" data-current-category="{{categoria}}">
            <option value="">Todas as categorias</option>
            <option value="Alimentos">Alimentos</option>
            <option value="Bebidas">Bebidas</option>
            <option value="Decoração">Decoração</option>
            <option value="Equipamentos">Equipamentos</option>
            <option value="Transporte">Transporte</option>
        </select>

        <select id="filter-status" data-current-status="{{status}}">
            <option value="">Todos os status</option>
            <option value="Ativo">Ativo</option>
            <option value="Inativo">Inativo</option>
        </select>

        <select id="supplier-page-size" aria-label="Fornecedores por página" data-current-limit="{{limit}}">
            <option value="10">10 por página</option>
            <option value="25">25 por página</option>
            <option value="50">50 por página</option>
        </select>

        <button id="btn-search-suppliers" class="btn btn-secondary" type="button">Pesquisar</button>
        <button id="btn-clear-supplier-filters" class="btn btn-secondary" type="button">Limpar</button>
    </div>

    <!-- Tabela -->
    <div class="table-container">
        <table class="supplier-table">
            <thead>
                <tr>
                    <th>Fornecedor</th>
                    <th>Categoria</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th>Cidade</th>
                    <th>Status</th>
                    <th aria-label="Opções do fornecedor"></th>
                </tr>
            </thead>

            <tbody id="supplier-tbody"></tbody>
        </table>
    </div>

  <nav class="pagination" id="pagination" aria-label="Paginação de fornecedores"></nav>

</main>

<div id="supplierRowMenu" class="record-row-menu" popover="auto" role="menu" aria-label="Ações do fornecedor">
    <button type="button" role="menuitem" data-record-action="edit">
        <i class="fa-solid fa-pen" aria-hidden="true"></i> Editar fornecedor
    </button>
    <button type="button" class="record-row-delete" role="menuitem" data-record-action="delete">
        <i class="fa-solid fa-trash" aria-hidden="true"></i> Excluir fornecedor
    </button>
</div>

<dialog id="supplierDetailsDialog" class="record-details-dialog" aria-labelledby="supplierDetailsTitle">
    <div class="record-details-header">
        <h2 id="supplierDetailsTitle">Detalhes do fornecedor</h2>
        <button type="button" class="record-details-close" data-close-supplier-details aria-label="Fechar detalhes">×</button>
    </div>
    <p class="record-details-error" role="alert" hidden></p>
    <dl class="record-details-grid">
        <div><dt>Fornecedor</dt><dd data-supplier-detail="nome"></dd></div>
        <div><dt>CNPJ / CPF</dt><dd data-supplier-detail="cnpj"></dd></div>
        <div><dt>Responsável</dt><dd data-supplier-detail="responsavel"></dd></div>
        <div><dt>Categoria</dt><dd data-supplier-detail="categoria"></dd></div>
        <div><dt>Telefone</dt><dd data-supplier-detail="telefone"></dd></div>
        <div><dt>WhatsApp</dt><dd data-supplier-detail="whatsapp"></dd></div>
        <div><dt>E-mail</dt><dd data-supplier-detail="email"></dd></div>
        <div><dt>Site</dt><dd data-supplier-detail="site"></dd></div>
        <div><dt>Endereço</dt><dd data-supplier-detail="endereco"></dd></div>
        <div><dt>Cidade / Estado</dt><dd data-supplier-detail="cidade_estado"></dd></div>
        <div><dt>CEP</dt><dd data-supplier-detail="cep"></dd></div>
        <div><dt>Produtos ou serviços</dt><dd data-supplier-detail="produtos"></dd></div>
        <div><dt>Prazo de entrega</dt><dd data-supplier-detail="entrega"></dd></div>
        <div><dt>Forma de pagamento</dt><dd data-supplier-detail="pagamento"></dd></div>
        <div><dt>Status</dt><dd data-supplier-detail="status"></dd></div>
        <div><dt>Observações</dt><dd data-supplier-detail="observacoes"></dd></div>
    </dl>
</dialog>

<!-- Modal Cadastro -->
<div class="modal-overlay" id="modal-form">
    <div class="modal">

        <h2 id="form-title">Cadastrar Fornecedor</h2>

        <form id="supplier-form">

            <input type="hidden" id="f-id">

            <!-- Dados da Empresa -->
            <div class="form-section">Dados da Empresa</div>

            <div class="form-grid">

                <div class="form-group">
                    <label>Nome da Empresa *</label>
                    <input type="text" id="f-name" required>
                </div>

                <div class="form-group">
                    <label>CNPJ / CPF *</label>
                    <input type="text" id="f-cnpj" required>
                </div>

                <div class="form-group">
                    <label>Responsável *</label>
                    <input type="text" id="f-responsavel" required>
                </div>

                <div class="form-group">
                    <label>Categoria *</label>

                    <select id="f-category" required>
                        <option value="">Selecione</option>
                        <option>Alimentos</option>
                        <option>Bebidas</option>
                        <option>Decoração</option>
                        <option>Equipamentos</option>
                        <option>Transporte</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Telefone *</label>
                    <input type="text" id="f-phone" required>
                </div>

                <div class="form-group">
                    <label>WhatsApp</label>
                    <input type="text" id="f-whatsapp">
                </div>

                <div class="form-group">
                    <label>E-mail *</label>
                    <input type="email" id="f-email" required>
                </div>

                <div class="form-group">
                    <label>Site</label>
                    <input type="text" id="f-website">
                </div>
            </div>

            <!-- Endereço -->
            <div class="form-section">Endereço</div>

            <div class="form-grid">

                <div class="form-group full">
                    <label>Rua / Avenida *</label>
                    <input type="text" id="f-street" required>
                </div>

                <div class="form-group">
                    <label>Número *</label>
                    <input type="text" id="f-number" required>
                </div>

                <div class="form-group">
                    <label>Bairro *</label>
                    <input type="text" id="f-neighborhood" required>
                </div>

                <div class="form-group">
                    <label>Cidade *</label>
                    <input type="text" id="f-city" required>
                </div>

                <div class="form-group">
                    <label>Estado *</label>
                    <input type="text" id="f-state" maxlength="2" required>
                </div>

                <div class="form-group">
                    <label>CEP *</label>
                    <input type="text" id="f-cep" required>
                </div>
            </div>

            <!-- Informações Comerciais -->
            <div class="form-section">Informações Comerciais</div>

            <div class="form-grid">
                <div class="form-group full">
                    <label>Produtos ou Serviços *</label>
                    <input type="text" id="f-product" required>
                </div>

                <div class="form-group">
                    <label>Prazo de Entrega</label>
                    <input type="text" id="f-delivery">
                </div>

                <div class="form-group">
                    <label>Forma de Pagamento</label>
                    <input type="text" id="f-payment">
                </div>

                <div class="form-group full">
                    <label>Observações</label>
                    <textarea id="f-notes" rows="4"></textarea>
                </div>

            </div>

            <div class="form-group">
                <label>Status</label>
                <select id="f-status">
                    <option value="Ativo">Ativo</option>
                    <option value="Inativo">Inativo</option>
                </select>
            </div>

            <div class="form-actions">
                <button
                type="button"
                class="btn btn-secondary"
                id="btn-cancel-supplier">
                Cancelar
                </button>

                <button
                type="submit"
                class="btn btn-primary">
                Salvar Fornecedor
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/js/fornecedor.js"></script>