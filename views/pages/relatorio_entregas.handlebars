<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Romaneio de Entrega</title>
  <link rel="stylesheet" href="/css/pages/relatorio_entregas.css">
</head>
<body class="romaneio-page">
  <nav class="romaneio-actions no-print" aria-label="Ações do romaneio">
    <a href="/entregas" class="action-button secondary">Voltar para Entregas</a>
    <button type="button" class="action-button primary" onclick="window.print()">Imprimir Romaneio</button>
    <span class="selection-note">{{pedidos.length}} pedido(s) selecionado(s) para esta rota</span>
  </nav>

  <main class="romaneio-document">
    <header class="romaneio-header">
      <div>
        <p class="brand">FESTGEST</p>
        <h1>ROMANEIO DE ENTREGA</h1>
      </div>
      <div class="route-fields">
        <div><strong>Data da rota:</strong> {{data_rota}}</div>
        <div><strong>Entregador:</strong> {{#if entregador_rota}}{{entregador_rota}}{{else}}____________________{{/if}}</div>
        <div><strong>Veículo:</strong> {{#if veiculo_rota}}{{veiculo_rota}}{{else}}____________________{{/if}}</div>
        <div><strong>Saída:</strong> ______:______ &nbsp; <strong>Retorno:</strong> ______:______</div>
      </div>
    </header>

    {{#each pedidos}}
    <section class="stop">
      <div class="stop-heading">
        <h2>PARADA {{this.pos}} <span>|</span> PEDIDO #{{this.id}}</h2>
      </div>
      <div class="customer-line">
        {{this.cliente}} <span>TEL: {{this.telefone}}</span> <span>TEL. CONTATO: {{this.telefone_contato}}</span>
      </div>
      <div class="address-block"><strong>ENDEREÇO:</strong> {{this.endereco}}</div>
      <div class="dates-row">
        <span><strong>ENTREGA:</strong> {{this.data_entrega}}</span>
        <span><strong>EVENTO:</strong> {{this.data_evento}}</span>
        <span><strong>RETIRADA:</strong> {{this.data_retirada}}</span>
      </div>
      <table class="items-table">
        <thead><tr><th>QTD.</th><th>PRODUTO</th><th>ENTREG.</th><th>RECOLH.</th><th>FALTA</th></tr></thead>
        <tbody>
          {{#each this.itens}}
          <tr><td>{{this.quantidade}}</td><td>{{this.produto}}</td><td></td><td></td><td></td></tr>
          {{/each}}
        </tbody>
      </table>
      <div class="money-row">
        <span><strong>TOTAL:</strong> {{this.total_formatado}}</span>
        <span><strong>JÁ PAGO:</strong> {{this.pago_formatado}}</span>
        <span><strong>A RECEBER:</strong> {{this.receber_formatado}}</span>
      </div>
      {{#if this.observacao}}
      <p class="existing-note"><strong>Observação do pedido:</strong> {{this.observacao}}</p>
      {{/if}}
      <div class="handwriting-block">
        <strong>OBSERVAÇÕES:</strong>
        <div class="writing-lines"><span></span><span></span></div>
      </div>
      <div class="signature-block"><strong>ASSINATURA / CONFIRMAÇÃO:</strong><span></span></div>
    </section>
    {{/each}}

    <section class="route-control">
      <h2>CONTROLE DA ROTA</h2>
      <table>
        <thead><tr><th>PARADA</th><th>PEDIDO</th><th>CLIENTE</th><th>SITUAÇÃO</th></tr></thead>
        <tbody>
          {{#each pedidos}}
          <tr><td>{{this.pos}}</td><td>#{{this.id}}</td><td>{{this.cliente}}</td><td>☐ OK &nbsp; ☐ PARCIAL</td></tr>
          {{/each}}
        </tbody>
      </table>
      <div class="route-counts">
        <span>ENTREGAS COMPLETAS: ______</span>
        <span>ENTREGAS PARCIAIS: ______</span>
        <span>ENTREGAS NÃO REALIZADAS: ______</span>
      </div>
      <div class="general-notes"><strong>OBSERVAÇÕES GERAIS DA ROTA</strong><span></span><span></span><span></span></div>
      <div class="driver-signature"><strong>ASSINATURA DO ENTREGADOR:</strong><span></span></div>
    </section>
  </main>
</body>
</html>
