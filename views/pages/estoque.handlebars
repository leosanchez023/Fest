<link rel="stylesheet" href="/css/pages/estoque.css">

<div class="estoque-wrap">
  <div class="estoque-header card">
    <div class="page-meta" data-title="Controle de Estoque" data-subtitle="Gerencie produtos, estoque, movimentações e disponibilidade"></div>
    <button type="button" class="btn-primary" onclick="carregarResumo()"><i class="fa-solid fa-rotate icon-sm"></i> Atualizar</button>
  </div>

  <div class="kpis">
    <div class="kpi-card">
      <span>Produtos</span>
      <strong id="kpi-total">0</strong>
    </div>
    <div class="kpi-card green">
      <span>Físico</span>
      <strong id="kpi-fisico">0</strong>
    </div>
    <div class="kpi-card blue">
      <span>Reservado</span>
      <strong id="kpi-reservado">0</strong>
    </div>
    <div class="kpi-card purple">
      <span>Em uso</span>
      <strong id="kpi-uso">0</strong>
    </div>
    <div class="kpi-card amber">
      <span>Manutenção</span>
      <strong id="kpi-manutencao">0</strong>
    </div>
    <div class="kpi-card red">
      <span>Danificado</span>
      <strong id="kpi-danificado">0</strong>
    </div>
    <div class="kpi-card slate">
      <span>Disponível</span>
      <strong id="kpi-disponivel">0</strong>
    </div>
  </div>

  <div class="card estoque-panel">
    <h2>Resumo por produto</h2>
    <div class="estoque-toolbar">
      <input id="estoque-busca" type="search" placeholder="Pesquisar produto..." aria-label="Pesquisar produto">
      <select id="estoque-status" aria-label="Filtrar por status">
        <option value="">Todos os status</option>
        <option value="NORMAL">Normal</option>
        <option value="BAIXO">Estoque baixo</option>
        <option value="RESERVADO">Reservado</option>
        <option value="EM_USO">Em uso</option>
        <option value="MANUTENCAO">Manutenção</option>
        <option value="DANIFICADO">Danificado</option>
      </select>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Físico</th>
            <th>Reservado</th>
            <th>Em uso</th>
            <th>Manutenção</th>
            <th>Danificado</th>
            <th>Disponível</th>
            <th>Mínimo</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody id="estoque-tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="card estoque-panel">
    <h2>Histórico de movimentações</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Produto</th>
            <th>Tipo</th>
            <th>Quantidade</th>
            <th>Observação</th>
          </tr>
        </thead>
        <tbody id="estoque-historico-tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script src="/js/estoque.js"></script>
