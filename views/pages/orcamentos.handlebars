<link rel="stylesheet" href="/css/pages/pedidos.css">

<div class="container">
  <div class="page-meta" data-title="Orçamentos" data-subtitle="Lista de orçamentos"></div>

  <div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <input id="q" class="input" placeholder="Pesquisar por cliente, telefone, número..." style="width:320px;">
      </div>
      <div>
        <button id="btn-new" class="btn"><i class="fa-solid fa-plus icon-sm"></i> Novo Orçamento</button>
      </div>
    </div>

    <div class="table-wrap" style="margin-top:12px;">
      <table class="table">
        <thead>
          <tr>
            <th>#</th>
            <th>Cliente</th>
            <th>Telefone</th>
            <th>Data Evento</th>
            <th>Valor Total</th>
            <th>Pago</th>
            <th>Saldo</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody id="orcamentos-tbody"></tbody>
      </table>
    </div>
  </div>
</div>

<script src="/js/orcamentos.js"></script>
