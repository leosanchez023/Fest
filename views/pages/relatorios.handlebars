<div class="page-meta" data-title="Relatórios" data-subtitle="Acompanhe o desempenho da sua empresa"></div>
<style>
  .relatorios-page {
    --bg: #f4f5fb;
    --card: #ffffff;
    --ink: #1d1f2b;
    --muted: #6b7084;
    --line: #e6e8f2;
    --brand: #3f5efb;
    --brand-strong: #2c46d9;
    --brand-2: #8b5cf6;
    --ok: #1fa971;
    --warn: #e8a317;
    --bad: #e5484d;
    --info: #2f7cf6;
    --radius: 14px;
    --shadow: 0 1px 2px rgba(20, 20, 50, 0.05), 0 6px 20px rgba(20, 20, 50, 0.06);
  }

  .relatorios-page * { box-sizing: border-box; }
  .relatorios-page {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
    background: var(--bg);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.4;
    overflow-x: clip;
  }

  .relatorios-page button,
  .relatorios-page input,
  .relatorios-page select { font: inherit; color: inherit; }

  .relatorios-page .main {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 26px 30px 50px;
  }

  .relatorios-page .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .relatorios-page .topbar h1 {
    margin: 0;
    font-size: 26px;
    letter-spacing: -0.3px;
  }

  .relatorios-page .topbar p {
    margin: 2px 0 0;
    color: var(--muted);
  }

  .relatorios-page .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .relatorios-page .btn {
    border: 1px solid var(--line);
    background: var(--card);
    padding: 9px 15px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.15s ease;
    min-height: 42px;
  }

  .relatorios-page .btn:hover { border-color: var(--brand); color: var(--brand); }
  .relatorios-page .btn.primary {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .relatorios-page .btn.primary:hover { background: var(--brand-strong); color: #fff; }
  .relatorios-page .menu-toggle { display: none; }

  .relatorios-page .tabs {
    display: flex;
    gap: 6px;
    background: var(--card);
    padding: 6px;
    border-radius: 12px;
    box-shadow: var(--shadow);
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    margin-bottom: 18px;
    scrollbar-width: thin;
  }

  .relatorios-page .tab {
    border: 0;
    background: transparent;
    padding: 9px 16px;
    border-radius: 9px;
    cursor: pointer;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .relatorios-page .tab:hover { color: var(--ink); }
  .relatorios-page .tab.active {
    background: var(--ink);
    color: #fff;
  }

  .relatorios-page .filters {
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 16px 18px;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 14px;
    align-items: start;
    margin-bottom: 18px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .relatorios-page .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }

  .relatorios-page .field label {
    display: block;
    min-height: 16px;
    margin: 0;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
  }

  .relatorios-page .field input,
  .relatorios-page .field select {
    width: 100%;
    max-width: 100%;
    height: 42px;
    min-height: 42px;
    border: 1px solid var(--line);
    background: #fff;
    padding: 0 11px;
    border-radius: 9px;
    min-width: 0;
    outline: none;
  }

  .relatorios-page .field .chips {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .relatorios-page .filters > .field:first-child { grid-column: span 2; }
  .relatorios-page .filters > .field.grow { grid-column: span 2; }
  .relatorios-page .field[hidden] { display: none; }

  .relatorios-page .field input:focus,
  .relatorios-page .field select:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(109, 74, 255, 0.15);
  }

  .relatorios-page .field select:disabled { background: #f1f2f8; color: #a0a4b8; }
  .relatorios-page .chips {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
    min-width: 0;
  }
  .relatorios-page .chip {
    border: 1px solid var(--line);
    background: #fff;
    min-width: 0;
    min-height: 42px;
    margin: 0;
    padding: 6px 8px;
    border-radius: 999px;
    cursor: pointer;
    font-weight: 600;
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .relatorios-page .chip:hover { border-color: var(--brand); color: var(--brand); }
  .relatorios-page .chip.active {
    background: rgba(109, 74, 255, 0.1);
    border-color: var(--brand);
    color: var(--brand);
  }

  .relatorios-page .grow { flex: 1 1 260px; min-width: 0; }
  .relatorios-page .note {
    font-size: 12px;
    color: var(--muted);
    margin: -8px 0 14px;
    display: none;
  }
  .relatorios-page #reportLoading:not([hidden]),
  .relatorios-page #reportError:not([hidden]) { display: block; }
  .relatorios-page #reportError:not([hidden]) { color: #b42318; }

  .relatorios-page .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 14px;
    margin-bottom: 18px;
  }

  .relatorios-page .kpi {
    background: var(--card);
    color: var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 16px 18px;
    position: relative;
    min-width: 0;
  }

  .relatorios-page .kpi::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--c, var(--brand));
  }

  .relatorios-page .kpi .l {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
  }

  .relatorios-page .kpi .v {
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 750;
    margin: 6px 0 4px;
    letter-spacing: -0.5px;
    line-height: 1.2;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .relatorios-page .kpi .d {
    font-size: 12.5px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .relatorios-page .up { color: var(--ok); font-weight: 700; }
  .relatorios-page .down { color: var(--bad); font-weight: 700; }

  .relatorios-page .charts {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 14px;
    margin-bottom: 18px;
  }

  .relatorios-page .card {
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 18px;
    min-width: 0;
  }

  .relatorios-page .card h3 {
    font-size: 15px;
    margin: 0 0 14px;
  }

  .relatorios-page .bars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 210px;
    padding-top: 10px;
    min-width: 0;
  }

  .relatorios-page .bar {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    min-width: 0;
  }

  .relatorios-page .bar div {
    width: 100%;
    max-width: 38px;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--brand), #a58cff);
    transition: height 0.4s;
    min-height: 2px;
  }

  .relatorios-page .bar div:hover { filter: brightness(1.1); }
  .relatorios-page .bar small {
    font-size: 10px;
    color: var(--muted);
    margin-top: 6px;
    height: 14px;
    white-space: nowrap;
  }

  .relatorios-page .donut-wrap {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .relatorios-page .donut {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  .relatorios-page .donut::after {
    content: attr(data-total);
    position: absolute;
    inset: 26px;
    background: var(--card);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 750;
    font-size: 15px;
    text-align: center;
    line-height: 1.2;
  }

  .relatorios-page .legend {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 13px;
    flex: 1;
    min-width: 130px;
  }

  .relatorios-page .legend div { display: flex; align-items: center; gap: 8px; }
  .relatorios-page .legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .relatorios-page .legend b { margin-left: auto; padding-left: 10px; }

  .relatorios-page .hbars { display: flex; flex-direction: column; gap: 11px; }
  .relatorios-page .hbar .t { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
  .relatorios-page .hbar .tr {
    height: 9px;
    background: #eef0f8;
    border-radius: 99px;
    overflow: hidden;
  }
  .relatorios-page .hbar .tr div {
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--brand), var(--brand-2));
  }

  .relatorios-page .empty { color: var(--muted); padding: 30px 0; text-align: center; }
  .relatorios-page .report-error {
    margin: 0 0 18px;
    padding: 12px 16px;
    border: 1px solid #f3b5b7;
    border-radius: 10px;
    background: #fff0f0;
    color: #8f1d22;
  }

  .relatorios-page .table-card {
    padding: 0;
    overflow: hidden;
    min-width: 0;
  }

  .relatorios-page .table-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 18px;
    gap: 10px;
    flex-wrap: wrap;
  }

  .relatorios-page .table-head h3 { margin: 0; }
  .relatorios-page .table-head span { color: var(--muted); font-size: 13px; }
  .relatorios-page .scroll { overflow-x: auto; }
  .relatorios-page table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }

  .relatorios-page th {
    background: #f8f9fd;
    text-align: left;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    padding: 11px 18px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .relatorios-page th:hover { color: var(--brand); }
  .relatorios-page th .ar { opacity: 0.5; margin-left: 4px; }
  .relatorios-page td {
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .relatorios-page tbody tr:hover { background: #faf9ff; }
  .relatorios-page .r { text-align: right; }
  .relatorios-page .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 700;
  }

  .relatorios-page .b-ok { background: #e3f7ee; color: #127a52; }
  .relatorios-page .b-info { background: #e3eeff; color: #1d5fc9; }
  .relatorios-page .b-warn { background: #fdf1d6; color: #9a6a00; }
  .relatorios-page .b-bad { background: #fde5e6; color: #b4282d; }
  .relatorios-page .b-def { background: #eef0f8; color: #555a73; }

  .relatorios-page .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    color: var(--muted);
    font-size: 13px;
    gap: 10px;
    flex-wrap: wrap;
  }

  .relatorios-page .pager div { display: flex; gap: 6px; }
  .relatorios-page .pager button {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 8px;
    padding: 6px 12px;
    cursor: pointer;
    font-weight: 600;
  }

  .relatorios-page .pager button:disabled { opacity: 0.4; cursor: default; }
  .relatorios-page .print-head { display: none; }

  @media (max-width: 1100px) {
    .relatorios-page .charts { grid-template-columns: 1fr; }
  }

  @media (max-width: 1280px) {
    .relatorios-page .filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .relatorios-page .filters > .field { grid-column: span 1; }
    .relatorios-page .filters > .field:first-child,
    .relatorios-page .filters > .field.grow { grid-column: span 2; }
  }

  @media (max-width: 640px) {
    .relatorios-page .filters { grid-template-columns: minmax(0, 1fr); }
    .relatorios-page .filters > .field { grid-column: 1 / -1 !important; }
    .relatorios-page .chips { grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); }
  }

  @media (max-width: 860px) {
    .relatorios-page .main { padding: 18px 16px 40px; }
    .relatorios-page .menu-toggle { display: inline-flex; }
  }

</style>

<link rel="stylesheet" href="/css/pages/relatorios.css">
<script id="report-data" type="application/json">{{{reportDataJson}}}</script>

<main class="main relatorios-page">
  <div class="report-error" id="reportError" role="alert" {{#unless reportError}}hidden{{/unless}}>{{reportError}}</div>
  <div class="topbar">
    <div style="display:flex;gap:12px;align-items:center">
      <button class="btn menu-toggle" id="menuBtn" aria-label="Menu">☰</button>
      <div>
        <h1>Relatórios</h1>
        <p id="subtitle">Acompanhe o desempenho da sua empresa</p>
      </div>
    </div>
    <div class="actions">
      <button class="btn" id="btnPrint">🖨️ Imprimir / PDF</button>
      <button class="btn primary" id="btnCsv">⬇️ Exportar CSV</button>
    </div>
  </div>

  <div class="tabs" id="tabs"></div>

  <div class="filters">
    <div class="field">
      <label>Período rápido</label>
      <div class="chips" id="chips"></div>
    </div>
    <div class="field"><label for="from">De</label><input type="date" id="from"></div>
    <div class="field"><label for="to">Até</label><input type="date" id="to"></div>
    <div class="field"><label for="status" id="statusLabel">Situação</label>
      <select id="status"></select>
    </div>
    <div class="field grow"><label for="q">Buscar</label><input type="search" id="q" placeholder="Cliente, produto, número..."></div>
    <div class="field" hidden><label for="extraFilter">Filtro adicional</label><select id="extraFilter"></select></div>
  </div>
  <div class="note" id="note"></div>
  <div class="note" id="reportLoading" aria-live="polite" hidden>Atualizando relatório…</div>

  <div class="print-head" id="printHead"></div>

  <section class="kpis" id="kpis"></section>
  <section class="charts" id="charts"></section>

  <section class="card table-card">
    <div class="table-head"><h3 id="tableTitle">Detalhamento</h3><span id="count"></span></div>
    <div class="scroll"><table><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
    <div class="pager">
      <span id="pageInfo"></span>
      <div><button id="prev">← Anterior</button><button id="next">Próxima →</button></div>
    </div>
  </section>
</main>

<script src="/js/relatorios.js"></script>
