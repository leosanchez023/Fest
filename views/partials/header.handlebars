<header class="top-header">
  <div class="header-inner">

    <div class="page-meta-display">
      <nav class="breadcrumb" aria-label="Navegação estrutural">
        <a href="/dashboard">Início</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb-current">Visão geral</span>
      </nav>
      <h2 class="page-title" aria-live="polite"></h2>
      <p class="page-subtitle muted"></p>
    </div>

    <div class="header-actions">
      <span class="header-status"><i class="fa-solid fa-circle"></i> Sistema online</span>
      <div class="user-menu"><i class="fa-solid fa-user-circle"></i><span>Olá, {{#if user}}{{user.name}}{{else}}Usuário{{/if}}</span></div>
    </div>
  </div>

  <script>
    // Preenche título e subtítulo do header a partir de um elemento .page-meta na página
    document.addEventListener('DOMContentLoaded', function(){
      try{
        var meta = document.querySelector('.page-meta');
        var titleEl = document.querySelector('.page-title');
        var subEl = document.querySelector('.page-subtitle');
        if(meta && titleEl){
          var t = meta.getAttribute('data-title') || meta.dataset.title || '';
          var s = meta.getAttribute('data-subtitle') || meta.dataset.subtitle || '';
          titleEl.textContent = t;
          subEl.textContent = s;
          var breadcrumbCurrent = document.querySelector('.breadcrumb-current');
          if (breadcrumbCurrent && t) breadcrumbCurrent.textContent = t;
        }
      }catch(e){console.warn('page-meta init',e)}
    });
  </script>
</header>
