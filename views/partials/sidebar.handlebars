<aside id="sidebar" class="sidebar" role="navigation" aria-label="Menu principal">

  <div class="sidebar-header">
    <div class="sidebar-brand">
      <div class="brand-logo" aria-hidden="true"><i class="fa-solid fa-cake-candles"></i></div>
      <div class="brand-info">
        <div class="brand-title">FEST</div>
        <div class="brand-sub muted">Sistema de Gestão</div>
      </div>
    </div>
    <button class="sidebar-toggle" type="button" aria-label="Recolher menu" aria-expanded="true">
      <i class="fa-solid fa-bars"></i>
    </button>
  </div>

  <nav class="sidebar-nav">

    {{#if userPermissions.dashboard}}
      <a class="nav-item" href="/dashboard"><i class="fa-solid fa-chart-simple ni"></i><span>Dashboard</span></a>
    {{/if}}

    <div class="sidebar-section" data-sidebar-group="pedidos">
      <button class="sidebar-group-toggle" type="button" aria-expanded="false" aria-controls="sidebar-pedidos">
        <i class="fa-solid fa-cart-shopping ni"></i><span>Pedidos</span><i class="fa-solid fa-chevron-right group-chevron" aria-hidden="true"></i>
      </button>
      <div class="sidebar-submenu" id="sidebar-pedidos">
        {{#if userPermissions.pedidos}}<a class="nav-item" href="/pedidos"><i class="fa-solid fa-cart-shopping ni"></i><span>Pedidos</span></a>{{/if}}
        {{#if userPermissions.pedidos}}<a class="nav-item" href="/orcamentos"><i class="fa-solid fa-file-invoice-dollar ni"></i><span>Orçamentos</span></a>{{/if}}
        {{#if userPermissions.entregas}}<a class="nav-item" href="/entregas"><i class="fa-solid fa-truck ni"></i><span>Entregas</span></a>{{/if}}
      </div>
    </div>

    <div class="sidebar-section" data-sidebar-group="cadastros">
      <button class="sidebar-group-toggle" type="button" aria-expanded="false" aria-controls="sidebar-cadastros">
        <i class="fa-solid fa-users ni"></i><span>Cadastros</span><i class="fa-solid fa-chevron-right group-chevron" aria-hidden="true"></i>
      </button>
      <div class="sidebar-submenu" id="sidebar-cadastros">
        {{#if userPermissions.clientes}}<a class="nav-item" href="/clientes"><i class="fa-solid fa-users ni"></i><span>Clientes</span></a>{{/if}}
        {{#if userPermissions.fornecedor}}<a class="nav-item" href="/fornecedores"><i class="fa-solid fa-industry ni"></i><span>Fornecedores</span></a>{{/if}}
        {{#if userPermissions.cadastro_admin}}<a class="nav-item" href="/usuarios"><i class="fa-solid fa-user-gear ni"></i><span>Funcionários</span></a>{{/if}}
      </div>
    </div>

    <div class="sidebar-section" data-sidebar-group="estoque">
      <button class="sidebar-group-toggle" type="button" aria-expanded="false" aria-controls="sidebar-estoque">
        <i class="fa-solid fa-boxes-packing ni"></i><span>Estoque</span><i class="fa-solid fa-chevron-right group-chevron" aria-hidden="true"></i>
      </button>
      <div class="sidebar-submenu" id="sidebar-estoque">
        {{#if userPermissions.produtos}}<a class="nav-item" href="/produtos"><i class="fa-solid fa-box-open ni"></i><span>Produtos</span></a>{{/if}}
        {{#if userPermissions.produtos}}<a class="nav-item" href="/combos"><i class="fa-solid fa-puzzle-piece ni"></i><span>Combos</span></a>{{/if}}
      </div>
    </div>

    <div class="sidebar-section" data-sidebar-group="relatorios">
      <button class="sidebar-group-toggle" type="button" aria-expanded="false" aria-controls="sidebar-relatorios">
        <i class="fa-solid fa-chart-line ni"></i><span>Relatórios</span><i class="fa-solid fa-chevron-right group-chevron" aria-hidden="true"></i>
      </button>
      <div class="sidebar-submenu" id="sidebar-relatorios">
        {{#if userPermissions.relatorios}}<a class="nav-item" href="/relatorios"><i class="fa-solid fa-chart-line ni"></i><span>Relatórios</span></a>{{/if}}
        {{#if userPermissions.relatorios}}<a class="nav-item" href="/devedores"><i class="fa-solid fa-user-clock ni"></i><span>Devedores</span></a>{{/if}}
      </div>
    </div>

  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <span class="sidebar-user-avatar"><i class="fa-solid fa-user"></i></span>
      <span class="sidebar-user-copy">
        <strong>{{#if user}}{{user.name}}{{else}}Usuário{{/if}}</strong>
        <small>Conta ativa</small>
      </span>
    </div>
    <button class="nav-item logout" onclick="window.location.href='/logout'"><i class="fa-solid fa-right-from-bracket ni"></i><span>Sair</span></button>
    <div class="copyright">© 2026 Sistema de Festas</div>
  </div>

</aside>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const sidebar = document.getElementById('sidebar');
  const toggle = document.querySelector('.sidebar-toggle');
  if (sidebar && toggle) {
    toggle.addEventListener('click', function(){
      const collapsed = sidebar.classList.toggle('is-collapsed');
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute('aria-label', collapsed ? 'Expandir menu' : 'Recolher menu');
    });
  }
  const groups = document.querySelectorAll('[data-sidebar-group]');
  const links = document.querySelectorAll('.sidebar-submenu .nav-item');
  const path = window.location.pathname.replace(/\/$/, '') || '/dashboard';

  const setGroup = (group, open) => {
    group.classList.toggle('open', open);
    const toggle = group.querySelector('.sidebar-group-toggle');
    if (toggle) toggle.setAttribute('aria-expanded', String(open));
  };

  groups.forEach(group => {
    const toggle = group.querySelector('.sidebar-group-toggle');
    const submenu = group.querySelector('.sidebar-submenu');
    if (!toggle || !submenu || !submenu.children.length) {
      group.remove();
      return;
    }
    toggle.addEventListener('click', () => {
      const willOpen = !group.classList.contains('open');
      groups.forEach(other => setGroup(other, other === group && willOpen));
    });
  });

  links.forEach(link => {
    const href = link.getAttribute('href') || link.dataset.href || '';
    if(!href) return;
    // marca ativo se for igual ou prefixo (ex: /produtos/123)
    if(path === href || path.indexOf(href) === 0) {
      link.classList.add('active');
      const section = link.closest('[data-sidebar-group]');
      if(section) setGroup(section, true);
    }
  });
});
</script>