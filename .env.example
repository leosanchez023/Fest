DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=fest
SESSION_SECRET=troque_esta_chave_por_uma_string_aleatoria
NODE_ENV=development
# APIs públicas baseadas em dados OpenStreetMap; sem chave de API.
# Photon oferece autocomplete (o Nominatim público não permite autocomplete).
# A origem da rota é informada em cada pedido no campo "Origem desta entrega".
FEST_PHOTON_URL=https://photon.komoot.io/api/
# O serviço OSRM público é demonstrativo, sem garantia de disponibilidade.
# Para produção, configure uma instância/serviço de roteamento compatível.
FEST_OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
# Regra atual do FestaGest: R$ 2,50 por km da rota, somente ida.
FEST_FRETE_PRECO_KM=2.50
