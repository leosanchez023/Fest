# PostgreSQL destination (Supabase) used by the application and migration scripts.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres
# Download the project's CA certificate from Supabase Database Settings > SSL Configuration.
DATABASE_CA_CERT=./certs/prod-ca-2021.crt
DB_POOL_MAX=10

# Read-only MySQL source used only by the one-time import script.
MYSQL_SOURCE_URL=mysql://<USER>:<PASSWORD>@<HOST>:3306/<DATABASE>

# Required by Express session middleware.
SESSION_SECRET=<LONG_RANDOM_SECRET>

# Used only once by `npm run db:seed:admin`; keep real values in ignored .env.
INITIAL_ADMIN_NAME=<ADMIN_DISPLAY_NAME>
INITIAL_ADMIN_EMAIL=<ADMIN_EMAIL>
INITIAL_ADMIN_PASSWORD=<STRONG_PASSWORD>
